# --- Robinhood Chain ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_WS_URL=wss://rpc.mainnet.chain.robinhood.com

# --- Postgres ---
DATABASE_URL=postgres://user:pass@localhost:5432/rhood

# --- Anthropic ---
ANTHROPIC_API_KEY=
# default: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- X (Twitter) API v2 user-context ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_USER_ID=

# --- Reply budget (hard caps; 0 = never reply) ---
MAX_REPLIES_PER_15MIN=10
MAX_REPLIES_PER_DAY=100
MAX_REPLIES_PER_MONTH=1500

# --- Optional overrides ---
# UNI_V3_FACTORY=0x1f7d7550B1b028F7571E69A784071F0205FD2EfA
# L2_GATEWAY_ROUTER=0x1E324B9316138CA9a73F960213621AD1aaf01B89
# HYPERSYNC_URL=https://robinhood.hypersync.xyz
# unused: look ticks post at most once, only if the analyzer returns a post
# MAX_POSTS_PER_CYCLE=1
# DRY_RUN=false

# --- Equity prints (premium/discount vs Chainlink) ---
# FINNHUB_API_KEY=
# POLYGON_API_KEY=

# --- Beat thresholds ---
# WHALE_USD_THRESHOLD=50000
# STOCK_BASIS_THRESHOLD_PCT=0.8
# GRADUATION_USD=50000
# LIQ_PULL_USD=25000
# TRACKED_WALLETS=0xabc...,0xdef...
